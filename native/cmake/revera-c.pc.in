prefix=@revera_pc_prefix@
libdir=${prefix}/@revera_pc_libdir@
includedir=${prefix}/@revera_pc_includedir@

Name: revera-c
Description: POSIX ERE regular expressions for C11, with a leftmost-longest engine and CLDR locales
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lrevera_c
Cflags: -I${includedir}
