{
  "name": "revera",
  "version": "0.1.0",
  "description": "POSIX.1-2024 extended regular expressions, generated from the Revera Vego engine",
  "license": "MIT",
  "type": "module",
  "main": "./dist/revera.js",
  "types": "./dist/revera.d.ts",
  "exports": {
    ".": {
      "types": "./dist/revera.d.ts",
      "default": "./dist/revera.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSES"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/data.bin dist/data.bin",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/",
    "prepack": "npm run build"
  },
  "keywords": [
    "regex",
    "posix",
    "ere",
    "regular-expressions"
  ],
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^5.9.3"
  }
}
